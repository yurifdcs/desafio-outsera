{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": ["state", "cities"],
  "properties": {
    "state": { "type": "string", "minLength": 2, "maxLength": 2 },
    "cities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
